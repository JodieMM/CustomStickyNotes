<Window x:Class="CustomStickyNotes.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Sticky Note"
        Width="260" Height="260"
        MinWidth="140" MinHeight="120"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="30"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="0"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#5A5A5A" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#4A4A4A" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="#FFF6E5">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="New Note" Click="NewNote_Click" />
                <MenuItem Header="Duplicate Note" Click="DuplicateNote_Click" />
                <Separator />
                <MenuItem Header="Delete Note…" Click="DeleteNote_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar / drag region -->
            <Grid x:Name="TitleBarGrid" Grid.Row="0" Visibility="Hidden">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="ColorButton" Grid.Column="0" Style="{StaticResource TitleBarButton}"
                        Margin="4,0,0,0" ToolTip="Change color" Click="ColorButton_Click">
                    <Ellipse Width="14" Height="14" Stroke="#33000000" StrokeThickness="1">
                        <Ellipse.Fill>
                            <SolidColorBrush x:Name="ColorDotBrush" Color="#FFF6E5" />
                        </Ellipse.Fill>
                    </Ellipse>
                </Button>

                <Button x:Name="PinButton" Grid.Column="2" Style="{StaticResource TitleBarButton}"
                        ToolTip="Always on top" Click="PinButton_Click" Content="📌" />

                <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource TitleBarButton}"
                        Margin="0,0,4,0" ToolTip="Archive note (keeps it in the notes list)"
                        Click="CloseButton_Click" Content="✕" FontSize="11" />
            </Grid>

            <!-- Formatting toolbar -->
            <StackPanel x:Name="ToolbarPanel" Grid.Row="1" Orientation="Horizontal" Margin="4,0,0,2"
                        Visibility="Hidden"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <ToggleButton x:Name="BoldButton" Style="{StaticResource ToolbarButton}"
                              ToolTip="Bold" Click="BoldButton_Click">
                    <TextBlock Text="B" FontWeight="Bold" />
                </ToggleButton>
                <ToggleButton x:Name="ItalicButton" Style="{StaticResource ToolbarButton}"
                              ToolTip="Italic" Click="ItalicButton_Click">
                    <TextBlock Text="I" FontStyle="Italic" />
                </ToggleButton>
                <ToggleButton x:Name="StrikeButton" Style="{StaticResource ToolbarButton}"
                              ToolTip="Strikethrough" Click="StrikeButton_Click">
                    <TextBlock Text="S" TextDecorations="Strikethrough" />
                </ToggleButton>
                <Border Width="1" Height="16" Background="#22000000" Margin="3,0" VerticalAlignment="Center" />
                <ToggleButton x:Name="BulletsButton" Style="{StaticResource ToolbarButton}"
                              ToolTip="Bullet list" Click="BulletsButton_Click">
                    <TextBlock Text="&#8226;&#8226;&#8226;" FontSize="8" />
                </ToggleButton>
                <ToggleButton x:Name="NumberingButton" Style="{StaticResource ToolbarButton}"
                              ToolTip="Numbered list" Click="NumberingButton_Click">
                    <TextBlock Text="1." FontSize="10" />
                </ToggleButton>
            </StackPanel>

            <RichTextBox x:Name="Rtb" Grid.Row="2" Margin="6,0,6,6" Padding="2"
                         Background="Transparent" BorderThickness="0"
                         VerticalScrollBarVisibility="Auto"
                         AcceptsTab="True"
                         SelectionChanged="Rtb_SelectionChanged"
                         TextChanged="Rtb_TextChanged" />
        </Grid>
    </Border>
</Window>
